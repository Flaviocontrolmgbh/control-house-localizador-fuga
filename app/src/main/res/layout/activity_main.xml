<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:padding="18dp" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="CONTROL HOUSE\nLOCALIZADOR DE FUGA" android:textStyle="bold" android:textSize="24sp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:text="Diagnóstico por comparação de resistência de isolamento (MΩ)" android:layout_marginBottom="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/client" android:hint="Cliente / local" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/circuit" android:hint="Circuito" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/before" android:hint="Medição antes de isolar o trecho (MΩ)" android:inputType="numberDecimal" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/after" android:hint="Medição após isolar o trecho (MΩ)" android:inputType="numberDecimal" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/point" android:hint="Trecho/ponto isolado (ex.: Caixa 7 → Tomada 8)" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/analyze" android:text="ANALISAR FUGA" android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/result" android:textSize="18sp" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:text="SEGURANÇA: realizar ensaios de isolamento somente com o circuito desenergizado. Desconectar equipamentos sensíveis conforme procedimento do instrumento e normas aplicáveis. O resultado é auxílio diagnóstico e deve ser confirmado em campo." android:textSize="13sp" android:layout_marginTop="20dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
